PORT=8080
GEOPORTAL_BASE_URL=https://sedeaplicaciones.minetur.gob.es/ServiciosRESTCarburantes/PreciosCarburantes

# El Geoportal solo actualiza precios una o dos veces al día, así que en
# producción no tiene sentido bajar de unas pocas horas (p.ej. 24h).
# En desarrollo, un intervalo corto (10m) permite ver el refresco funcionar
# sin esperar horas. Formato: cualquier valor válido para time.ParseDuration
# de Go (p.ej. 10m, 1h, 24h).
REFRESH_INTERVAL=10m

# Ruta del snapshot en disco, para servir datos inmediatamente al arrancar
# sin esperar al primer refresco.
SNAPSHOT_PATH=./data/snapshot.json
